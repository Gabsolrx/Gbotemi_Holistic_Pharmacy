# ==============================================================================
# GBOTEMI HOLISTIC PHARMACY - VERCEL & PRODUCTION ENVIRONMENT CONFIGURATION
# Add these variables under your Vercel Project Settings -> Environment Variables
# ==============================================================================

# 1. Supabase Client Credentials (Public Frontend - starts with VITE_)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# 2. Supabase Server-Side Secret Key (BACKEND ONLY - Do NOT expose to client)
# Used by Vercel Serverless Functions (/api/upload, /api/auth/signup) to bypass RLS safely
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 3. Google Gemini AI API Key (BACKEND ONLY)
# Used by the AI Pharmacist Chatbot (/api/chat)
GEMINI_API_KEY="your-gemini-api-key"

# 4. WhatsApp Pharmacy Contact Configuration
VITE_WHATSAPP_NUMBER="2348029660153"

# 5. Production Environment Flags
NODE_ENV="production"
