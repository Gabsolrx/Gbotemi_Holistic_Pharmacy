# Supabase Configuration
# Create a project at https://supabase.com to get these keys
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# BACKEND ONLY: Required for scripts/setupAdmin.js to securely create the initial admin
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
ADMIN_INITIAL_PASSWORD="YOUR_INITIAL_SECURE_PASSWORD"

# Paystack Configuration
# Get these from your Paystack Dashboard (Settings -> API Keys & Webhooks)
PAYSTACK_PUBLIC_KEY="YOUR_PAYSTACK_PUBLIC_KEY"
PAYSTACK_SECRET_KEY="YOUR_PAYSTACK_SECRET_KEY"

# Gemini AI Configuration
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Contact Configuration
WHATSAPP_NUMBER="08029660153"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
